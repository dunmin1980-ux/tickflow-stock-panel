          "title": "Predicate",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ClaimProvenance"
        },
        "rendering": {
          "$ref": "#/$defs/RenderingSpec"
        },
        "scope": {
          "$ref": "#/$defs/ClaimScope"
        },
        "subject": {
          "$ref": "#/$defs/StockSubject"
        },
        "validation_status": {
          "const": "VALIDATED",
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "provenance",
        "rendering",
        "scope",
        "validation_status",
        "claim_type",
        "predicate",
        "object"
      ],
      "title": "BooleanStateClaim",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "none",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        },
        "value_type": {
          "const": "boolean",
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "value_type",
        "value",
        "unit"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "ClaimProvenance": {
      "additionalProperties": false,
      "properties": {
        "calculation_ref": {
          "anyOf": [
            {
              "enum": [
                "compare_numbers_v1",
                "ordered_relation_v1",
                "difference_v1",
                "percentage_difference_v1",
                "threshold_compare_v1",
                "normalize_scope_v1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculation Ref"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "facts_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Facts Sha256",
          "type": "string"
        },
        "price_basis": {
          "enum": [
            "raw",
            "qfq",
            "none"
          ],
          "title": "Price Basis",
          "type": "string"
        }
      },
      "required": [
        "facts_sha256",
        "fact_refs",
        "calculation_ref",
        "price_basis"
      ],
      "title": "ClaimProvenance",
      "type": "object"
    },
    "ClaimScope": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "As Of",
